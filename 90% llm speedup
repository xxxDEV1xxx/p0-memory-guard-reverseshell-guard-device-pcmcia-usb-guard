import json
import subprocess
import sys
import urllib.request

MODEL = "qwen2.5:1.5b"
URL = "http://127.0.0.1:11434/api/chat"


def freezer(action):
    subprocess.run(
        ["systemctl", action, "ollama.service"],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.DEVNULL,
        check=False,
    )


def ask(messages):
    payload = {
        "model": MODEL,
        "messages": messages,
        "stream": True,
        "think": False,
        "keep_alive": -1,
        "options": {
            "num_ctx": 8192,
            "num_batch": 8192,
            "num_predict": 256,
        },
    }

    req = urllib.request.Request(
        URL,
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )

    answer = []

    with urllib.request.urlopen(req, timeout=300) as response:
        while True:
            line = response.readline()
            if not line:
                break

            obj = json.loads(line)

            text = (obj.get("message") or {}).get("content") or ""
            if text:
                sys.stdout.write(text)
                sys.stdout.flush()
                answer.append(text)

            if obj.get("done"):
                break

    sys.stdout.write("\n")
    sys.stdout.flush()

    return "".join(answer)


def main():
    messages = [{"role": "system", "content": "You are Odysseus."}]

    # Park the model while waiting for keyboard input.
    freezer("freeze")

    print(f"{MODEL} parked. Type and press Enter.", flush=True)

    while True:
        try:
            text = input("> ")
        except (EOFError, KeyboardInterrupt):
            print()
            freezer("freeze")
            return

        if not text.strip():
            continue

        # User submitted a line: wake the preserved llama.cpp process.
        freezer("thaw")

        messages.append({"role": "user", "content": text})

        try:
            answer = ask(messages)
        except Exception as exc:
            print(f"\n[LLM ERROR] {exc}", file=sys.stderr, flush=True)
            messages.pop()
            freezer("freeze")
            continue

        messages.append({"role": "assistant", "content": answer})

        # Terminal output is complete. Freeze the resident model.
        freezer("freeze")


if __name__ == "__main__":
    main()
