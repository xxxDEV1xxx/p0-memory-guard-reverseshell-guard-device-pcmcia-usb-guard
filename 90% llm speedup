#######################
add bash alias for sleep to work and keep llm warm
#######################
cat >> /root/.bashrc <<'EOF'

# === Christopher T. Williams - LLM Runtime Control ===
llm() {
    case "${1:-}" in
        sleep|freeze)
            systemctl freeze ollama.service
            echo "LLM: FROZEN"
            ;;

        wake|thaw)
            systemctl thaw ollama.service
            echo "LLM: THAWED"
            ;;

        status)
            echo "=== LLM FREEZER ==="
            systemctl show ollama.service \
                -p ActiveState \
                -p FreezerState \
                -p MainPID

            echo
            echo "=== LLM PROCESSES ==="
            ps -eo pid,stat,pcpu,pmem,comm | \
                grep -E 'ollama|llama-server' | \
                grep -v grep || true

            echo
            echo "=== MODEL ==="
            curl -sS http://127.0.0.1:11434/api/ps
            echo
            ;;

        "")
            echo "Usage:"
            echo "  llm sleep"
            echo "  llm wake"
            echo "  llm status"
            echo "  llm <ollama arguments>"
            ;;

        *)
            systemctl thaw ollama.service

            command ollama "$@"
            rc=$?

            systemctl freeze ollama.service
            echo "LLM: FROZEN"

            return $rc
            ;;
    esac
}
EOF

